# Copy to deployment/.env. Do not commit real credentials.
RABBITMQ_USER=skitrak
RABBITMQ_PASSWORD=replace-with-a-local-development-password
RABBITMQ_VHOST=/
# The supplied OFFICIAL 40-lift JSON is in deployment/config/lift_vertical.json.
LIFT_CONFIG_DIR=./config
LIFT_VERTICAL_FILE_IN_CONTAINER=/config/lift_vertical.json
ALLOW_DEMO_LIFTS=false
CONSUMER_THREADS=10
CONSUMER_MIN_THREADS=5
CONSUMER_DYNAMIC_SCALING=true
PREFETCH_COUNT=64
ACK_BATCH_SIZE=1
ACK_FLUSH_MS=25
STORE_BATCH_SIZE=32
STORE_BATCH_WAIT_MS=10
TOP_N=20
CHANNEL_POOL_SIZE=32
PUBLISH_CONFIRM_TIMEOUT_MS=3000
QUEUE_TTL_MS=86400000
QUEUE_MAX_LENGTH=100000
